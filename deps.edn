;; Three first-party dependencies, all leaves, all real implementations
;; rather than seams:
;;
;;   org-nist-sha2               SHA-256 and HMAC-SHA256, portable
;;   org-ietf-x25519             one KEM's Diffie-Hellman
;;   org-ietf-x448               another
;;   org-nist-ecc                the three NIST ones
;;   org-ietf-chacha20-poly1305  one AEAD
;;   org-nist-aes                the other two
;;
;; NOT kotoba-lang/crypto: its hkdf hardcodes a zero salt, which RFC 9180's
;; key schedule needs to vary, and its default digest is a JVM MessageDigest.
;; NOT kotoba-lang/noise: its AEAD is host-injected through provider/.
{:paths ["src"]
 :deps {io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
         :git/sha "e7c1b250adf3291ef99424fa85d8e7381cb086fb"}
        io.github.kotoba-lang/org-ietf-x25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-x25519.git"
         :git/sha "8c4e1ae7c6f14e5d015bcb8ca80e965ad808d920"}
        io.github.kotoba-lang/org-ietf-chacha20-poly1305
        {:git/url "https://github.com/kotoba-lang/org-ietf-chacha20-poly1305.git"
         :git/sha "599e4733be1a2b6539be8dd0704771cdbdef4d63"}
        io.github.kotoba-lang/org-nist-aes
        {:git/url "https://github.com/kotoba-lang/org-nist-aes.git"
         :git/sha "7834b2f04729ab77259da26a8d728fe3595f041e"}
        io.github.kotoba-lang/org-nist-ecc
        {:git/url "https://github.com/kotoba-lang/org-nist-ecc.git"
         :git/sha "b255b97f99e5eb21eb12a632b3e589ed224a7977"}
        io.github.kotoba-lang/org-ietf-x448
        {:git/url "https://github.com/kotoba-lang/org-ietf-x448.git"
         :git/sha "929a789f03823eb2baf81aaaa3d9b2c44e046b83"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}

  ;; The differential oracle. BouncyCastle is test-scoped and never reaches
  ;; :deps. Both -d directories are named, because the runner defaults to
  ;; `test` alone and would otherwise exit 0 having never loaded the oracle.
  :oracle {:extra-paths ["test" "oracle"]
           :extra-deps {org.bouncycastle/bcprov-jdk18on {:mvn/version "1.78.1"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
           :main-opts ["-m" "cognitect.test-runner" "-d" "test" "-d" "oracle"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "oracle"
                     "--fail-level" "error"]}}}
